---
import Base from '../layouts/Base.astro';
import Accesos from '../components/Accesos.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import { servicios, contacto } from '../data/servicios';
import { u } from '../lib/url';

const s = (slug: string) => servicios.find((x) => x.slug === slug)!;
const chicos = ['cirugia-tiroides', 'trasplante-renal', 'diabetes', 'endocrinologia'].map(s);

const novedades = [
  { titulo: 'El hospital restablece la guardia de 24 horas', tema: 'Atención', foto: 'edificio', href: 'https://www.salta.gob.ar/prensa/noticias/el-hospital-oniativia-restablece-el-servicio-de-guardia-las-24-horas-101658' },
  { titulo: 'Más prevención y atención del cáncer de tiroides', tema: 'Tiroides', foto: 'cirugia-tiroides', href: 'https://www.salta.gob.ar/prensa/noticias/el-hospital-oniativia-fortalece-la-prevencion-y-la-atencion-del-cancer-de-tiroides-110185' },
  { titulo: 'Nuevo espacio de diálisis peritoneal', tema: 'Nefrología', foto: 'peritoneal', href: 'https://www.salta.gob.ar/prensa/noticias/con-dialisis-peritoneal-fortalecen-la-atencion-nefrologica-en-el-hospital-arturo-oniativia-108101' },
  { titulo: 'Se hicieron 38 trasplantes renales en 2023', tema: 'Trasplante', foto: 'trasplante', href: 'https://www.salta.gob.ar/prensa/noticias/se-hicieron-38-trasplantes-renales-en-el-hospital-oniativia-durante-2023-93713' },
  { titulo: 'Investigan la deficiencia de yodo en escuelas', tema: 'Investigación', foto: 'escuela', href: 'https://www.salta.gob.ar/prensa/noticias/se-realiza-una-investigacion-sobre-la-deficiencia-de-yodo-en-ninios-en-edad-escolar-102932' },
];
---
<Base activo="inicio">
  <!-- Hero -->
  <section class="pt-12 text-center md:pt-20">
    <div class="wrap">
      <h1 class="t-hero">Hospital Dr. Arturo Oñativia</h1>
      <p class="t-lead mx-auto mt-4 max-w-[30ch] text-ink-2">Endocrinología, diabetes y riñón. Alta complejidad para todo Salta, con o sin obra social.</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
        <a href={u('/turnos')} class="btn btn-primary">Pedir turno</a>
        <a href={u('/especialidades')} class="link-chev text-[17px]">Ver especialidades <Icon name="caret-right" weight="bold" class="size-4" /></a>
      </div>
    </div>
    <div class="wrap-wide mt-10 md:mt-14">
      <figure class="reveal-scale tile overflow-hidden">
        <Foto nombre="frente" alt="Frente del Hospital Dr. Arturo Oñativia con su cartel y el busto de su primer director" class="aspect-[4/3] w-full object-cover object-[30%_50%] md:aspect-[21/9] md:object-[50%_8%]" priority sizes="100vw" />
      </figure>
    </div>
    <div class="wrap mt-8">
      <Accesos />
    </div>
  </section>

  <!-- Especialidades de referencia -->
  <section class="mt-12 bg-mist sec md:mt-24">
    <div class="wrap-wide">
      <div class="text-center">
        <h2 class="t-h2">Especialidades de referencia.</h2>
        <p class="t-lead mx-auto mt-3 max-w-[34ch] text-mute">Servicios que en Salta solo existen en un hospital público acá.</p>
      </div>

      <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-2 md:gap-5">
        <a href={u('/especialidades/hemodialisis')} class="reveal press group tile grid overflow-hidden bg-surface md:col-span-2 md:grid-cols-2">
          <div class="flex flex-col justify-center pad md:p-14">
            <p class="text-[15px] font-semibold text-accent">Único en un hospital público de Salta</p>
            <h3 class="t-h1 mt-2">Nefrología y Hemodiálisis</h3>
            <p class="mt-3 max-w-[38ch] text-ink-2">184 pacientes en tratamiento, 32 equipos y tres turnos por día. También diálisis peritoneal y trasplante renal.</p>
            <span class="link-chev mt-5">Conocé el servicio <Icon name="caret-right" weight="bold" class="size-4" /></span>
          </div>
          <Foto nombre="hemodialisis" alt="Enfermeras del servicio de diálisis preparando un equipo" class="aspect-[4/3] h-full w-full object-cover md:aspect-auto" sizes="(min-width: 768px) 50vw, 100vw" />
        </a>

        {chicos.map((x) => (
          <a href={u(`/especialidades/${x.slug}`)} class="reveal press group tile flex flex-col overflow-hidden bg-surface">
            <div class="pad pb-5 md:p-10 md:pb-7">
              <h3 class="t-h3">{x.nombre}</h3>
              <p class="mt-2 text-ink-2">{x.referencia}</p>
              <span class="link-chev mt-3">Más información <Icon name="caret-right" weight="bold" class="size-4" /></span>
            </div>
            <div class="mt-auto overflow-hidden">
              <Foto nombre={x.foto!} alt="" class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-[var(--ease-out-strong)] group-hover:scale-[1.03]" sizes="(min-width: 768px) 50vw, 100vw" />
            </div>
          </a>
        ))}

        <a href={u('/especialidades/medicina-nuclear')} class="reveal press group tile flex flex-col items-center overflow-hidden bg-night px-8 py-14 text-center text-white md:col-span-2 md:py-20">
          <span class="flex size-20 items-center justify-center rounded-[22px] bg-surface/10"><Icon name="atom" class="size-11" /></span>
          <h3 class="t-h1 mt-6">Medicina Nuclear</h3>
          <p class="t-lead mt-3 max-w-[32ch] text-white/75">El único servicio del NOA en un hospital público. Gammacámara de dos cabezales y tratamiento con yodo radiactivo.</p>
          <span class="mt-5 inline-flex items-center gap-1 text-[#6ea1ff] group-hover:underline">Más información <Icon name="caret-right" weight="bold" class="size-4" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <section class="sec">
    <div class="wrap">
      <h2 class="t-h2 text-center">El Oñativia, en números.</h2>
      <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 text-center md:grid-cols-4">
        {[
          ['70', 'años atendiendo en Salta'],
          ['184', 'pacientes en hemodiálisis'],
          ['38', 'trasplantes renales en 2023'],
          ['13.000', 'consultas de endocrinología en 2025'],
        ].map(([n, l]) => (
          <div class="reveal">
            <dt class="sr-only">{l}</dt>
            <dd class="t-h1 text-accent tabular-nums">{n}</dd>
            <dd class="mx-auto mt-2 max-w-[16ch] text-[15px] text-mute">{l}</dd>
          </div>
        ))}
      </dl>
      <p class="t-small mt-10 text-center text-mute">Fuente: Prensa del Gobierno de Salta.</p>
    </div>
  </section>

  <!-- Turnos -->
  <section class="bg-mist sec">
    <div class="wrap">
      <h2 class="t-h2 text-center">Pedí tu turno como prefieras.</h2>
      <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-3">
        <a href="tel:148" class="reveal press tile flex flex-col bg-surface pad">
          <Icon name="phone" class="size-9 text-accent" />
          <p class="mt-5 text-[15px] font-semibold text-mute">Por teléfono</p>
          <p class="t-h1 mt-1">148</p>
          <p class="mt-2 text-ink-2">Línea gratuita desde Salta Capital.</p>
          <span class="link-chev mt-auto pt-5">Llamar <Icon name="caret-right" weight="bold" class="size-4" /></span>
        </a>
        <a href={contacto.whatsappUrl} target="_blank" rel="noopener" class="reveal press tile flex flex-col bg-surface pad">
          <Icon name="whatsapp-logo" class="size-9 text-wa" />
          <p class="mt-5 text-[15px] font-semibold text-mute">Por WhatsApp</p>
          <p class="t-h3 mt-2">{contacto.whatsapp}</p>
          <p class="mt-2 text-ink-2">Si vivís en el interior de la provincia.</p>
          <span class="link-chev mt-auto pt-5">Escribir <Icon name="caret-right" weight="bold" class="size-4" /></span>
        </a>
        <div class="reveal tile flex flex-col bg-surface pad">
          <Icon name="buildings" class="size-9 text-accent" />
          <p class="mt-5 text-[15px] font-semibold text-mute">En persona</p>
          <p class="t-h3 mt-2">Admisión</p>
          <p class="mt-2 text-ink-2">Centro Ambulatorio, {contacto.direccion}.</p>
          <a href={contacto.mapa} target="_blank" rel="noopener" class="link-chev mt-auto pt-5">Cómo llegar <Icon name="caret-right" weight="bold" class="size-4" /></a>
        </div>
      </div>
      <a href={u('/turnos#guardia')} class="reveal press tile mt-4 flex flex-col items-start gap-4 bg-surface pad sm:flex-row sm:items-center">
        <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-alarm-tint text-alarm"><Icon name="siren" class="size-8" /></span>
        <span class="flex-1">
          <span class="t-h3 block">Guardia 24 horas</span>
          <span class="mt-1 block text-ink-2">Prioridad para pacientes con descompensaciones endocrino-metabólicas.</span>
        </span>
        <span class="link-chev">Ver la guardia <Icon name="caret-right" weight="bold" class="size-4" /></span>
      </a>
    </div>
  </section>

  <!-- El hospital -->
  <section class="sec">
    <div class="wrap-wide grid gap-4 md:grid-cols-2 md:gap-5">
      <a href={u('/el-hospital')} class="reveal press group tile flex flex-col overflow-hidden bg-night text-white">
        <div class="pad md:p-12">
          <p class="text-[15px] font-semibold text-white/60">Desde 1956</p>
          <h3 class="t-h2 mt-2">Setenta años en Salta.</h3>
          <p class="mt-3 max-w-[40ch] text-white/75">Nació como Instituto del Bocio y lleva el nombre de su primer director, el Dr. Arturo Oñativia.</p>
          <span class="mt-4 inline-flex items-center gap-1 text-[#6ea1ff] group-hover:underline">Historia del hospital <Icon name="caret-right" weight="bold" class="size-4" /></span>
        </div>
        <Foto nombre="edificio-historico" alt="Edificio histórico con el busto del Dr. Oñativia" class="mt-auto aspect-[16/10] w-full object-cover" sizes="(min-width: 768px) 50vw, 100vw" />
      </a>
      <a href={u('/el-hospital#investigacion')} class="reveal press group tile flex flex-col overflow-hidden bg-mist">
        <div class="pad md:p-12">
          <p class="text-[15px] font-semibold text-mute">Con el CONICET</p>
          <h3 class="t-h2 mt-2">Investigación y docencia.</h3>
          <p class="mt-3 max-w-[40ch] text-ink-2">La primera Unidad de Conocimiento Traslacional del NOA. Hoy estudian el bocio en escuelas de Salta.</p>
          <span class="link-chev mt-4">Conocé más <Icon name="caret-right" weight="bold" class="size-4" /></span>
        </div>
        <Foto nombre="investigacion" alt="Profesionales del hospital en una escuela" class="mt-auto aspect-[16/10] w-full object-cover" sizes="(min-width: 768px) 50vw, 100vw" />
      </a>
    </div>
  </section>

  <!-- Novedades: carrusel horizontal -->
  <section class="bg-mist sec" aria-labelledby="nov-t">
    <div class="wrap-wide">
      <div class="flex items-end justify-between gap-4 px-1">
        <h2 id="nov-t" class="t-h2">Novedades.</h2>
        <div class="hidden gap-2 md:flex">
          <button type="button" data-car="-1" class="press flex size-11 items-center justify-center rounded-full bg-ink/[.06] hover:bg-ink/10 disabled:opacity-40" aria-label="Anterior"><Icon name="caret-left" weight="bold" class="size-5" /></button>
          <button type="button" data-car="1" class="press flex size-11 items-center justify-center rounded-full bg-ink/[.06] hover:bg-ink/10 disabled:opacity-40" aria-label="Siguiente"><Icon name="caret-right" weight="bold" class="size-5" /></button>
        </div>
      </div>
      <ul id="carrusel" class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {novedades.map((n) => (
          <li class="w-[80%] shrink-0 snap-start sm:w-[46%] lg:w-[31%]">
            <a href={n.href} target="_blank" rel="noopener" class="press group card flex h-full flex-col overflow-hidden bg-surface">
              <Foto nombre={n.foto} alt="" class="aspect-[16/10] w-full object-cover" sizes="(min-width: 1024px) 31vw, 80vw" />
              <div class="flex flex-1 flex-col p-6">
                <p class="text-[13px] font-semibold text-mute">{n.tema}</p>
                <h3 class="mt-1 text-[19px] leading-snug font-semibold tracking-[-0.015em] group-hover:underline">{n.titulo}</h3>
                <span class="link-chev mt-auto pt-4 text-[15px]">Leer la nota <Icon name="arrow-up-right" weight="bold" class="size-4" /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p class="t-small mt-4 px-1 text-mute">Notas publicadas por Prensa del Gobierno de Salta.</p>
    </div>
  </section>

  <script>
    const track = document.getElementById('carrusel');
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-car]');
    function sync() {
      if (!track) return;
      btns.forEach((b) => {
        const dir = Number(b.dataset.car);
        b.disabled = dir < 0 ? track.scrollLeft <= 4 : track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      });
    }
    btns.forEach((b) => b.addEventListener('click', () => {
      if (!track) return;
      const card = track.querySelector('li');
      track.scrollBy({ left: Number(b.dataset.car) * ((card?.clientWidth ?? 300) + 16), behavior: 'smooth' });
    }));
    track?.addEventListener('scroll', sync, { passive: true });
    sync();
  </script>
</Base>
