---
import Base from '../../layouts/Base.astro';
import Buscador from '../../components/Buscador.tsx';
import { servicios, contacto } from '../../data/servicios';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = servicios.map(({ slug, nombre, categoria, resumen, claves, referencia }) => ({ slug, nombre, categoria, resumen, claves, referencia }));
---
<Base title="Especialidades" activo="especialidades" description={`Las ${servicios.length} especialidades y servicios del Hospital Dr. Arturo Oñativia.`}>
  <section class="bg-paper">
    <div class="wrap py-10 md:py-14">
      <h1 class="sign-text text-[52px] md:text-[72px]">Especialidades</h1>
      <p class="mt-3 max-w-xl text-lg text-steel">Buscá por nombre, estudio o lo que te pasa. Cada especialidad tiene su página con responsables y cómo pedir turno.</p>
    </div>
  </section>
  <div class="wrap max-w-[880px] py-10">
    <Buscador client:load servicios={items} base={base} conmutador={contacto.conmutador} />
  </div>
</Base>
