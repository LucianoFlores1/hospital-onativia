---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import { contacto } from '../data/servicios';
---
<Base title="Turnos y guardia" activo="turnos" description="Cómo pedir turno en el Hospital Oñativia: 148, WhatsApp o en persona. Guardia 24 horas.">
  <section class="pt-12 text-center md:pt-20">
    <div class="wrap">
      <h1 class="t-h1">Turnos y guardia.</h1>
      <p class="t-lead mx-auto mt-3 max-w-[34ch] text-mute">Tres formas de pedir turno. Para una descompensación endocrino-metabólica, la guardia atiende las 24 horas.</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="wrap grid gap-4 md:grid-cols-3">
      <a href="tel:148" class="reveal press tile flex flex-col bg-mist p-8">
        <Icon name="phone" class="size-9 text-accent" />
        <p class="mt-5 text-[15px] font-semibold text-mute">Por teléfono</p>
        <p class="t-h1 mt-1">148</p>
        <p class="mt-2 text-ink-2">Línea gratuita desde Salta Capital. Endocrinología, Diabetes, Obesidad, Nutrición, Patología Mamaria y Hepatología.</p>
        <span class="link-chev mt-auto pt-5">Llamar <Icon name="caret-right" weight="bold" class="size-4" /></span>
      </a>
      <a href={contacto.whatsappUrl} target="_blank" rel="noopener" class="reveal press tile flex flex-col bg-mist p-8">
        <Icon name="whatsapp-logo" class="size-9 text-wa" />
        <p class="mt-5 text-[15px] font-semibold text-mute">Por WhatsApp</p>
        <p class="t-h3 mt-2">{contacto.whatsapp}</p>
        <p class="mt-2 text-ink-2">Para quienes viven fuera de la capital.</p>
        <span class="link-chev mt-auto pt-5">Escribir <Icon name="caret-right" weight="bold" class="size-4" /></span>
      </a>
      <div class="reveal tile flex flex-col bg-mist p-8">
        <Icon name="buildings" class="size-9 text-accent" />
        <p class="mt-5 text-[15px] font-semibold text-mute">En persona</p>
        <p class="t-h3 mt-2">Admisión</p>
        <p class="mt-2 text-ink-2">Centro Ambulatorio, {contacto.direccion}.</p>
      </div>
    </div>
  </section>

  <section class="bg-mist py-16 md:py-24">
    <div class="wrap">
      <h2 class="t-h2 text-center">Qué llevar.</h2>
      <ul class="mx-auto mt-10 max-w-[640px] overflow-hidden card bg-white">
        {['DNI', 'Orden médica', 'Estudios previos', 'Derivación, si venís de otro centro', 'Credencial de obra social, si tenés'].map((t) => (
          <li class="flex items-center gap-3 border-b border-hair/70 px-5 py-4 last:border-b-0"><Icon name="check-circle" weight="fill" class="size-6 text-accent" /><span class="text-[17px]">{t}</span></li>
        ))}
      </ul>
      <p class="t-small mt-4 text-center text-mute">El hospital atiende con o sin obra social.</p>
    </div>
  </section>

  <section id="guardia" class="py-16 md:py-24">
    <div class="wrap-wide">
      <div class="reveal tile grid overflow-hidden bg-ink text-white md:grid-cols-2">
        <div class="flex flex-col justify-center p-8 md:p-14">
          <span class="flex size-14 items-center justify-center rounded-2xl bg-alarm"><Icon name="siren" class="size-8" /></span>
          <h2 class="t-h1 mt-6">Guardia 24 horas.</h2>
          <p class="mt-3 max-w-[40ch] text-white/75">Prioridad para pacientes con descompensaciones endocrino-metabólicas.</p>
          <p class="mt-6 max-w-[40ch] text-[15px] text-white/60">Ante una emergencia que pone en riesgo la vida, llamá al 107 (SAMEC) o al 911.</p>
        </div>
        <Foto nombre="edificio-2" alt="Ingreso al hospital sobre calle Paz Chaín" class="aspect-[4/3] h-full w-full object-cover md:aspect-auto" sizes="(min-width: 768px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap text-center">
      <h2 class="t-h2">Cómo llegar.</h2>
      <p class="t-lead mt-3 text-mute">{contacto.direccion}</p>
      <p class="mt-1 text-mute">Conmutador {contacto.conmutador}</p>
      <a href={contacto.mapa} target="_blank" rel="noopener" class="btn btn-primary mt-6">Abrir en el mapa</a>
    </div>
  </section>
</Base>
