---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';

const hitos = [
  ['1956', 'Se crea el Instituto del Bocio', 'Decreto-ley 191/56, para estudiar y prevenir la endemia bociosa del NOA.'],
  ['1958', 'Instituto de Endocrinología', 'Ley 3333. Convenio con la Universidad Nacional de Tucumán.'],
  ['1976', 'Hemodiálisis y Medicina Nuclear', 'Pasa a ser Instituto de Patología Regional.'],
  ['1985', 'Hospital Dr. Arturo Oñativia', 'Decreto 804, en homenaje a su primer director.'],
  ['2010', 'Unidad de Trasplante Renal', 'Para pacientes con o sin obra social.'],
  ['2018', 'Centro Ambulatorio y CONICET', 'Tres pisos de consultorios, extracciones, vacunatorio y turnos.'],
  ['2022', 'Primera UCT‑H del NOA', 'Unidad de Conocimiento Traslacional acreditada por el Ministerio de Salud de la Nación.'],
];
---
<Base title="El hospital" activo="hospital" description="Historia, investigación y docencia del Hospital Dr. Arturo Oñativia.">
  <section class="pt-12 text-center md:pt-20">
    <div class="wrap">
      <h1 class="t-h1">Setenta años cuidando<br class="hidden sm:block" /> la salud de Salta.</h1>
      <p class="t-lead mx-auto mt-4 max-w-[36ch] text-mute">Hospital Público de Gestión Descentralizada del Ministerio de Salud Pública. Alta complejidad en enfermedades endocrino-metabólicas.</p>
    </div>
    <div class="wrap-wide mt-10">
      <figure class="reveal-scale tile overflow-hidden">
        <Foto nombre="frente" alt="Frente del hospital con el cartel Hospital Oñativia y el busto del Dr. Arturo Oñativia" class="aspect-[4/3] w-full object-cover object-[30%_50%] md:aspect-[21/9] md:object-[50%_8%]" priority sizes="100vw" />
      </figure>
      <p class="t-small mt-3 text-center text-mute">Frente sobre calle Paz Chaín. Imagen restaurada digitalmente.</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap grid gap-12 md:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)]">
      <div>
        <h2 class="t-h2">Historia.</h2>
        <div class="reveal tile mt-8 bg-mist p-6">
          <Foto nombre="arturo-onativia" alt="Dr. Arturo Oñativia" class="card w-28 grayscale" sizes="112px" />
          <p class="mt-4 text-[19px] font-semibold tracking-[-0.015em]">Dr. Arturo Oñativia</p>
          <p class="text-[15px] text-mute">1914 a 1985</p>
          <p class="mt-3 text-ink-2">Médico endocrinólogo salteño, egresado de la UBA. Ganó por concurso la dirección del Instituto del Bocio en 1958. Fue docente, investigador y ministro de Salud de la Nación.</p>
        </div>
      </div>
      <ol class="relative border-l border-hair pl-8">
        {hitos.map(([a, t, d]) => (
          <li class="reveal relative pb-9 last:pb-0">
            <span class="absolute top-2 -left-[37px] size-2.5 rounded-full bg-accent ring-4 ring-white"></span>
            <p class="text-[15px] font-semibold text-accent tabular-nums">{a}</p>
            <p class="t-h3 mt-1">{t}</p>
            <p class="mt-1 text-ink-2">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="investigacion" class="bg-mist py-16 md:py-24">
    <div class="wrap-wide">
      <div class="text-center">
        <h2 class="t-h2">Investigación y docencia.</h2>
        <p class="t-lead mx-auto mt-3 max-w-[34ch] text-mute">La ciencia que nace en el hospital vuelve a la comunidad.</p>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-3 md:gap-5">
        {[
          ['microscope', 'Primera UCT‑H del NOA', 'Unidad de Conocimiento Traslacional junto al CONICET, con 21 investigadores y profesionales.', 'investigacion'],
          ['users-three', 'Yodo en escuelas', 'Más de 20 profesionales estudian el bocio en niños de 6 a 12 años para actualizar los datos de la provincia.', 'escuela'],
          ['graduation-cap', 'Residencias', 'Endocrinología y Nutrición, Nutrición Clínica y Nefrología. Inscripción en febrero por SISA.', 'consulta'],
        ].map(([ic, t, d, f]) => (
          <div class="reveal tile flex flex-col overflow-hidden bg-white">
            <div class="p-8">
              <Icon name={ic} class="size-8 text-accent" />
              <p class="t-h3 mt-4">{t}</p>
              <p class="mt-2 text-ink-2">{d}</p>
            </div>
            <Foto nombre={f} alt="" class="mt-auto aspect-[16/10] w-full object-cover" sizes="(min-width: 768px) 33vw, 100vw" />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
