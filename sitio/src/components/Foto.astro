---
// Foto real del hospital optimizada por Astro (AVIF y WebP en varios tamaños).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });

interface Props {
  nombre: string;
  alt: string;
  class?: string;
  sizes?: string;
  priority?: boolean;
}
const { nombre, alt, class: cls, sizes = '(min-width: 1024px) 50vw, 100vw', priority = false } = Astro.props;
const src = fotos[`../assets/fotos/${nombre}.jpg`]?.default;
if (!src) throw new Error(`Foto inexistente: ${nombre}`);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={[...new Set([480, 800, src.width].filter((w) => w <= src.width))]}
  sizes={sizes}
  class={cls}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
/>
